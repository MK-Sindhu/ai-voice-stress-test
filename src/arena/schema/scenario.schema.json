{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arena scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "family", "language", "title", "description", "steps", "checks"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "family": {
      "enum": [
        "mid_thought_pause", "barge_in", "backchannel", "numbers_details",
        "background_noise", "change_of_mind", "long_silence"
      ]
    },
    "language": {"enum": ["en-IN", "hi", "hinglish"]},
    "title": {"type": "string", "minLength": 3},
    "description": {"type": "string", "minLength": 10},
    "noise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "snr_db"],
      "properties": {
        "kind": {"enum": ["street", "tv", "crowd"]},
        "snr_db": {"type": "number", "minimum": 0, "maximum": 40}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/say"},
          {"$ref": "#/$defs/pause"},
          {"$ref": "#/$defs/listen"},
          {"$ref": "#/$defs/wait_agent_speech"},
          {"$ref": "#/$defs/silence"}
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/check_simple"},
          {"$ref": "#/$defs/check_reply"},
          {"$ref": "#/$defs/check_window"}
        ]
      }
    }
  },
  "$defs": {
    "say": {
      "type": "object",
      "additionalProperties": false,
      "required": ["say"],
      "properties": {
        "say": {"type": "string", "minLength": 1},
        "spoken": {"type": "string", "minLength": 1},
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "kind": {"enum": ["turn", "barge_in", "backchannel"]}
      }
    },
    "pause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pause"],
      "properties": {"pause": {"type": "number", "minimum": 0.2, "maximum": 5}}
    },
    "reply_text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": {"type": "number", "minimum": 1, "maximum": 30},
        "for": {"type": "number", "minimum": 0.5, "maximum": 10},
        "oracle": {"type": "string"},
        "oracle_spoken": {"type": "string"},
        "wrong": {"type": "string"},
        "wrong_spoken": {"type": "string"}
      }
    },
    "listen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listen"],
      "properties": {"listen": {"$ref": "#/$defs/reply_text"}}
    },
    "wait_agent_speech": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wait_agent_speech"],
      "properties": {
        "wait_agent_speech": {
          "allOf": [{"$ref": "#/$defs/reply_text"}, {"required": ["for"]}]
        }
      }
    },
    "silence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["silence"],
      "properties": {
        "silence": {"type": "number", "minimum": 1, "maximum": 30},
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"}
      }
    },
    "mentions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
    },
    "check_simple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["no_false_interruption", "barge_in_stops", "backchannel_ignored"]}
      }
    },
    "check_reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reply_to"],
      "anyOf": [{"required": ["digits"]}, {"required": ["mentions"]}],
      "properties": {
        "type": {"enum": ["detail", "recovery", "mentions"]},
        "reply_to": {"type": "string"},
        "digits": {"type": "string", "pattern": "^[0-9]+$"},
        "mentions": {"$ref": "#/$defs/mentions"}
      }
    },
    "check_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "during"],
      "properties": {
        "type": {"enum": ["checks_in", "silent_during"]},
        "during": {"type": "string"}
      }
    }
  }
}
